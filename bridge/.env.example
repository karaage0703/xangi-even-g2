# Use 0.0.0.0 for Tailscale direct HTTP.
# 127.0.0.1 is enough when publishing with `tailscale serve`.
EVEN_BRIDGE_HOST=0.0.0.0
EVEN_BRIDGE_PORT=8791
EVEN_BRIDGE_TOKEN=change-this-to-a-long-random-token

# xangi Web endpoint that provides /api/chat.
XANGI_BASE_URL=http://127.0.0.1:18888
EVEN_MAX_CHARS=400
EVEN_DEADLINE_SEC=22

EVEN_STT_HOST=127.0.0.1
EVEN_STT_PORT=8792

# Recommended for Japanese accuracy. Use base if memory is tight.
EVEN_STT_MODEL=medium
EVEN_STT_LANG=ja
