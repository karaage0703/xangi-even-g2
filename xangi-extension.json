{
  "schemaVersion": 2,
  "id": "xangi-even-g2",
  "displayName": "xangi-even-g2",
  "description": "Runs the Even G2 bridge and local speech-to-text service under xangi.",
  "permissions": [
    "accept authenticated Even G2 requests through the parent xangi device ingress",
    "connect to the parent xangi Web API",
    "run a local Whisper speech-to-text model",
    "read bridge/.env for local Even G2 settings"
  ],
  "version": "0.1.24",
  "entrypoint": "scripts/xangi-extension",
  "runtime": {
    "kind": "managed-http"
  },
  "setup": {
    "instructions": "XANGI_SETUP.md"
  },
  "update": {
    "prepare": {
      "command": "./scripts/prepare-update",
      "args": []
    }
  },
  "capabilities": [
    {
      "id": "device.even-g2",
      "protocol": "http",
      "healthPath": "/health"
    }
  ],
  "startup": {
    "exclusiveGroup": "gpu",
    "timeoutSeconds": 120
  },
  "deviceIngress": {
    "capability": "device.even-g2",
    "authentication": "extension-bearer"
  }
}
