# Development defaults for the Even Hub app.
# The iPhone companion screen can also save Bridge URL / Token in localStorage.
# For repeatable private builds, prefer `npm run pack:configured`.

# xangi-even-g2 bridge base URL, without a trailing slash.
# Recommended: Tailscale direct HTTP or Tailscale Serve HTTPS.
VITE_BRIDGE_URL=http://100.x.y.z:8791
# VITE_BRIDGE_URL=https://your-host.your-tailnet.ts.net

# Bearer token expected by the bridge.
VITE_BRIDGE_TOKEN=
